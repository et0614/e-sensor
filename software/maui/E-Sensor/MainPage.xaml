<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:E_Sensor"
             xmlns:res="clr-namespace:E_Sensor.Resources"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="E_Sensor.MainPage"
             x:DataType="viewmodels:MainViewModel"
             BackgroundColor="#F0F4F8"
             >

    <ContentPage.Resources>
        <Style x:Key="BaseMidiButtonStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="TextColor" Value="White" />
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseMidiButtonStyle}">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#3E5C76" />
                                <Setter Property="BorderColor" Value="#5483AB" />
                                <Setter Property="BorderWidth" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#253248" />
                                <Setter Property="TextColor" Value="#5D6D7E" />
                                <Setter Property="BorderColor" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="ToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseMidiButtonStyle}">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#253248" />
                                <Setter Property="TextColor" Value="#5D6D7E" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <!-- SafeAreaEdges: 全体はエッジツーエッジ(None)を維持し、暗色パネルの背景を画面端まで
         到達させる。最下部コンテンツの安全域回避は、パネル全体ではなくフッタ行だけに
         SafeAreaEdges を設定して行う(下記フッタ Grid 参照)。ここで下端を Container にすると
         パネルごと押し上げられ、下にページ背景(明色)の帯が露出してしまうため行わない。 -->
    <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='240, *'}"
          RowDefinitions="{OnIdiom Phone='*,Auto', Default='*'}"
          SafeAreaEdges="None">

        <!-- Padding: 電話では最下部パネルとなり、右下の角丸に e-sensor.jp/VER 行(右下隅に
             右寄せ配置)が食い込むため、右を広げて角の丸みから逃がす。高さは Auto なので
             内容に合わせて確保され、下端の safe area はグリッド側で別途インセットされる。 -->
        <VerticalStackLayout Grid.Column="0"
                             Grid.Row="{OnIdiom Phone=1, Default=0}"
                             Padding="{OnIdiom Phone='20,20,30,24', Default='20'}"
                             Spacing="15"
                             ZIndex="5"
                             BackgroundColor="#1B263B">

            <Grid VerticalOptions="Start" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <Label Text="CONNECTION" FontSize="10" FontAttributes="Bold" TextColor="#8E9AAF" VerticalOptions="Center" />
                    <Ellipse WidthRequest="12" HeightRequest="12" VerticalOptions="Center">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding IsDeviceLive}" Value="True">
                                <Setter Property="Fill" Value="#4CAF50" />
                            </DataTrigger>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding IsDeviceLive}" Value="False">
                                <Setter Property="Fill" Value="#F44336" />
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </HorizontalStackLayout>

                <Label x:Name="RecordCountLabel"
                       Grid.Column="2"
                       Text="{Binding RecordedCount, StringFormat='{0} Records'}"
                       FontSize="15" 
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />
            </Grid>

            <Button Command="{Binding ToggleRecordCommand}"
            Style="{StaticResource ToggleButtonStyle}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsRecording}" Value="False">
                        <Setter Property="Text" Value="{x:Static res:Strings.StartLogging}" />
                        <Setter Property="BackgroundColor" Value="#0078D4" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsRecording}" Value="True">
                        <Setter Property="Text" Value="{x:Static res:Strings.EndLogging}" />
                        <Setter Property="BackgroundColor" Value="#D83B01" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Text="{x:Static res:Strings.ExportMessage}"
                    Command="{Binding ExportDataCommand}"
                    Style="{StaticResource ExportButtonStyle}" />

            <!-- 風速計 On/Off トグル。ファーム v1.1.0 未満では無効化(灰色)される。
                 ON のとき温湿度は自己発熱補正値を、OFF のとき生値を表示する。 -->
            <HorizontalStackLayout Spacing="10" Margin="0,5,0,0" VerticalOptions="Center">
                <Label Text="{x:Static res:Strings.VelocitySensor}"
                       TextColor="White"
                       FontSize="13"
                       VerticalOptions="Center" />
                <Switch IsToggled="{Binding IsVelocityOn}"
                        IsEnabled="{Binding IsVelocityToggleSupported}"
                        VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- フッタ行。Web リンク(左端)と VER/ID クラスタ(右端)を可変スペーサーを挟んで
                 1 行に配置し、幅を使い切って縦を節約する。狭い画面(タブレット左パネル240等)
                 でも両端に寄せることで溢れにくくする。
                 SafeAreaEdges 下端 Container: この行だけを Android ナビゲーションバー／iOS
                 ホームインジケータの上へ逃がす。暗色パネル背景は画面端まで残るため下部に
                 明色の帯は出ない。 -->
            <Grid VerticalOptions="End" Margin="0,10,0,0" ColumnDefinitions="Auto,*,Auto"
                  SafeAreaEdges="None, None, None, Container">
                <!-- プロジェクト Web サイトへのリンク。タップで既定ブラウザを起動する。 -->
                <Label Grid.Column="0"
                       Text="e-sensor.jp"
                       FontSize="10"
                       TextColor="#8E9AAF"
                       TextDecorations="Underline"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenWebsiteCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <HorizontalStackLayout Grid.Column="2" HorizontalOptions="End" Spacing="5" VerticalOptions="Center">
                    <!-- 工場リセット / 初期調整など、頻度が低く誤操作のリスクがある操作は
                         小さなアイコンに集約してアクションシート経由で実行する。
                         iOS の MAUI ImageButton は小サイズ・透過背景・Padding=0 の組合せで
                         画像が描画されない既知の癖があるため、Image + TapGestureRecognizer
                         でアイコンを表示する。CanExecute は OpacityとInputTransparent の
                         DataTrigger で表現する。アイコン自体は SVG ではなく PNG を直接配置
                         する (iOS Resizetizer の SVG ラスタライズが特定環境で失敗する
                         ことがあるため)。 -->
                    <Image Source="maintenance.png"
                           WidthRequest="18"
                           HeightRequest="18"
                           Aspect="AspectFit"
                           Opacity="0.7"
                           Margin="0,0,6,0"
                           VerticalOptions="Center"
                           ToolTipProperties.Text="{x:Static res:Strings.Maintenance}"
                           AutomationProperties.Name="{x:Static res:Strings.Maintenance}">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenMaintenanceMenuCommand}" />
                        </Image.GestureRecognizers>
                        <Image.Triggers>
                            <DataTrigger TargetType="Image" Binding="{Binding IsDeviceLive}" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                                <Setter Property="InputTransparent" Value="True" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>
                    <Label Text="VER:" FontSize="10" TextColor="#8E9AAF" VerticalOptions="Center" />
                    <Label Text="{Binding FirmwareVersion}" FontSize="10" TextColor="White" VerticalOptions="Center" />

                    <Label Margin="10,0,0,0" Text="ID:" FontSize="10" TextColor="#8E9AAF" VerticalOptions="Center" />
                    <Label Text="{Binding DeviceId}" FontSize="10" TextColor="White" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

        </VerticalStackLayout>

        <ScrollView Grid.Column="{OnIdiom Phone=0, Default=1}"
                    Grid.Row="0"
                    Padding="0">
            <FlexLayout Wrap="Wrap" JustifyContent="SpaceEvenly" Padding="5">
                <FlexLayout.Triggers>
                    <DataTrigger TargetType="FlexLayout" Binding="{Binding IsDataFresh}" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </DataTrigger>
                    <DataTrigger TargetType="FlexLayout" Binding="{Binding IsDataFresh}" Value="True">
                        <Setter Property="Opacity" Value="1.0" />
                    </DataTrigger>
                </FlexLayout.Triggers>

                <viewmodels:SensorCard Title="{x:Static res:Strings.Temperature}" Value="{Binding Temperature}" Unit="C" BadgeText="{Binding TempHumBadgeText}" InfoBadgeText="{Binding TempHumInfoBadgeText}" InfoBadgeCommand="{Binding ShowCorrectionInfoCommand}" />
                <viewmodels:SensorCard Title="{x:Static res:Strings.RelativeHumidity}" Value="{Binding Humidity}" Unit="%" BadgeText="{Binding TempHumBadgeText}" InfoBadgeText="{Binding TempHumInfoBadgeText}" InfoBadgeCommand="{Binding ShowCorrectionInfoCommand}" />
                <viewmodels:SensorCard Title="{x:Static res:Strings.Velocity}" Value="{Binding Velocity}" Unit="m/s" BadgeText="{Binding VelocityBadgeText}" />
                <viewmodels:SensorCard Title="{x:Static res:Strings.Illuminance}" Value="{Binding Illuminance}" Unit="lux" />
                <viewmodels:SensorCard Title="{x:Static res:Strings.CO2Level}" Value="{Binding Co2Level}" Unit="ppm" BadgeText="{Binding Co2BadgeText}" />
                <!-- PMV（予測温冷感申告）。値=PMV、Unit スロットに PPD[%] を併記する。
                     歯車アイコン(SettingsCommand)から着衣量/代謝量を設定する。放射温度=気温と
                     仮定した簡易計算のため、風速計 OFF 時は算出せず未表示（ダッシュ）とする。 -->
                <viewmodels:SensorCard Title="{x:Static res:Strings.PmvTitle}" Value="{Binding Pmv}" Unit="{Binding PmvPpd}" InfoBadgeText="{Binding PmvSetting}" SettingsCommand="{Binding OpenPmvSettingsCommand}" />
            </FlexLayout>
        </ScrollView>

        <Grid  Grid.Column="{OnIdiom Phone=0, Default=1}" Grid.Row="0"
               VerticalOptions="End"
               HeightRequest="100" 
               Margin="0" 
               InputTransparent="True"
               IsVisible="{Binding IsDogVisible}">

            <skia:SKLottieView
                x:Name="DogLottie"
                Source="DogWalking.json"
                RepeatCount="-1"
                HorizontalOptions="Start"
                TranslationX="0"
                WidthRequest="100"
                HeightRequest="100"
                Margin="0,0,0,-30"/>
        </Grid>

    </Grid>
</ContentPage>