<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="E_Sensor.SensorCard"
             x:Name="this">
    <Border StrokeShape="RoundRectangle 12"
            StrokeThickness="1"
            Stroke="#D1E4F3"
            BackgroundColor="White"
            Margin="8"
            Padding="16"
            WidthRequest="160"
            HeightRequest="140">


        <Border.Shadow>
            <Shadow Offset="2,2" Radius="5" Opacity="0.1" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding Title, Source={x:Reference this}}"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="Start" />
                <!-- IsVisible / 値テキストの色は SensorCard.xaml.cs の UpdateBadgeVisuals() で
                     BadgeText の空/非空に応じて切り替える。XAML 側では DataTrigger の Value=""
                     比較が安定しないため code-behind で扱う。 -->
                <Border x:Name="BadgeBorder"
                        Grid.Column="1"
                        StrokeShape="RoundRectangle 4"
                        Stroke="#F39C12"
                        StrokeThickness="1"
                        BackgroundColor="#FEF5E7"
                        Padding="4,1"
                        VerticalOptions="Center">
                    <Label Text="{Binding BadgeText, Source={x:Reference this}}"
                           FontSize="9"
                           FontAttributes="Bold"
                           TextColor="#B9770E" />
                </Border>
            </Grid>

            <Label x:Name="ValueLabel"
                   Text="{Binding Value, Source={x:Reference this}}"
                   FontSize="36"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="{Binding Unit, Source={x:Reference this}}"
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalOptions="End" />
        </VerticalStackLayout>
    </Border>
</ContentView>
