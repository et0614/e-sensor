<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="E_Sensor.SensorCard"
             x:Name="this">
    <Border StrokeShape="RoundRectangle 12"
            StrokeThickness="1"
            Stroke="#D1E4F3"
            BackgroundColor="White"
            Margin="8"
            Padding="16"
            WidthRequest="160"
            HeightRequest="140">


        <Border.Shadow>
            <Shadow Offset="2,2" Radius="5" Opacity="0.1" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding Title, Source={x:Reference this}}"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="Start" />
                <!-- バッジは2種類。いずれも IsVisible / 値テキスト色は code-behind の
                     UpdateBadgeVisuals() で切り替える(DataTrigger の Value="" 比較が不安定なため)。
                     ・BadgeBorder(警告/橙): WARM-UP・初期調整中など「値が信頼できない」表示。
                       表示時は値を灰色化する。
                     ・InfoBadgeBorder(情報/青): 「補正値」など正しい補正済み値の注記。
                       値は灰色化せず、タップで説明ポップアップを出す。 -->
                <HorizontalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Border x:Name="InfoBadgeBorder"
                            StrokeShape="RoundRectangle 4"
                            Stroke="#5483AB"
                            StrokeThickness="1"
                            BackgroundColor="#EAF2FB"
                            Padding="4,1"
                            VerticalOptions="Center"
                            IsVisible="False">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding InfoBadgeCommand, Source={x:Reference this}}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding InfoBadgeText, Source={x:Reference this}}"
                               FontSize="9"
                               FontAttributes="Bold"
                               TextColor="#2C5F8A" />
                    </Border>
                    <Border x:Name="BadgeBorder"
                            StrokeShape="RoundRectangle 4"
                            Stroke="#F39C12"
                            StrokeThickness="1"
                            BackgroundColor="#FEF5E7"
                            Padding="4,1"
                            VerticalOptions="Center"
                            IsVisible="False">
                        <Label Text="{Binding BadgeText, Source={x:Reference this}}"
                               FontSize="9"
                               FontAttributes="Bold"
                               TextColor="#B9770E" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <Label x:Name="ValueLabel"
                   Text="{Binding Value, Source={x:Reference this}}"
                   FontSize="36"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="{Binding Unit, Source={x:Reference this}}"
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalOptions="End" />
        </VerticalStackLayout>
    </Border>
</ContentView>
